/*
 * Grammar so far supported, up to and including Chapter 4
 *
 * I am going a little off-piste with how I lay this out, and that's primarily
 * so that I can later encode my precedence order directly into the grammar.
 */

// Top level

program ::=
    function

// Declarations

function ::=
// void keyword is actually optional, this will be better once we can expect args
    "int" identifier "(" "void" ")" block

// Statements

block ::=
    "{" return "}"

return ::=
    "return" expression ";"

// Expressions, with precedence parsing

expression     ::= logical_or
logical_or     ::= logical_and
logical_and    ::= bitwise_or { "&&" bitwise_or }
bitwise_or     ::= bitwise_xor { "|" bitwise_xor }
bitwise_xor    ::= bitwise_and { "^" bitwise_and }
bitwise_and    ::= equality { "&" equality }
equality       ::= relational { ( "==" | "!=" ) relational }
relational     ::= shift { ( "<" | ">" | "<=" | ">=" ) shift }
shift          ::= additive { ( "<<" | ">>" ) additive }
additive       ::= multiplicative { ( "+" | "-" ) multiplicative }
multiplicative ::= factor { ( "*" | "/" | "%" ) factor }
factor         ::= ( "-" | "~" | "!" ) factor | "(" expression ")" | integer

// Raw types

identifier ::=
    alpha { alpha | digit }

integer ::=
    decimal_integer | octal_integer | hexadecimal_integer

decimal_integer ::=
    nonzero_digit { digit }

octal_integer ::=
    "0" { octal_digit }

hexadecimal_integer ::=
    "0" ( "x" | "X" ) hexadecimal_digit { hexadecimal_digit }

// Integer tokens are consumed as a whole: a leading zero selects octal, so 078 is invalid.
// Floating-point forms and integer suffixes are not yet supported.
// Values are also limited to signed 32-bit range.

alpha ::=
    [a-zA-Z_]

nonzero_digit ::=
    [1-9]

digit ::=
    [0-9]

octal_digit ::=
    [0-7]

hexadecimal_digit ::=
    [0-9a-fA-F]
