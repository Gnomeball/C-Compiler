/*
 * Grammar so far supported, up to and including Chapter 3
 *
 * I am going a little off-piste with how I lay this out, and that's primarily
 * so that I can later encode my precedence order directly into the grammar.
 */

// Top level

program ::=
    function

// Declarations

function ::=
// void keyword is optional, this will be better once we can expect args
    "int" identifier "(" "void" ")" block

// Statements

block ::=
    "{" return "}"

return ::=
    "return" expression ";"

// Expressions, with precedence parsing

expression     ::= logical_or
logical_or     ::= logical_and
logical_and    ::= bitwise_or { "&&" bitwise_or }
bitwise_or     ::= bitwise_xor { "|" bitwise_xor }
bitwise_xor    ::= bitwise_and { "^" bitwise_and }
bitwise_and    ::= equality { "&" equality }
equality       ::= relational { ( "==" | "!=" ) relational }
relational     ::= shift { ( "<" | ">" | "<=" | ">=" ) shift }
shift          ::= additive { ( "<<" | ">>" ) additive }
additive       ::= multiplicative { ( "+" | "-" ) multiplicative }
multiplicative ::= factor { ( "*" | "/" | "%" ) factor }
factor         ::= ( "-" | "~" | "!" ) factor | "(" expression ")" | integer

// Raw types

identifier ::=
    alpha+

integer ::=
    digit+

alpha ::=
    [a-zA-Z_]

digit ::=
    [0-9]
